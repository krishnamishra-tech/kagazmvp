  "fields": [
    { "id": "applicant_name",   "canonical": "name",            "label_hi": "आवेदक का नाम",   "required": true,  "transform": "title_case",   "coordinates": [110, 650] },
    { "id": "father_name",      "canonical": "father_name",      "label_hi": "पिता का नाम",     "required": true,  "transform": "title_case",   "coordinates": [110, 620] },
    { "id": "address",          "canonical": "address_line1",    "label_hi": "पूर्ण पता",       "required": true,  "transform": "wrap_2line",    "coordinates": [110, 590] },
    { "id": "village_town",     "canonical": "village_town",      "label_hi": "ग्राम/पंचायत",   "required": true,  "coordinates": [110, 540] },
    { "id": "district",         "canonical": "district",         "label_hi": "जिला",           "required": true,  "coordinates": [320, 540] },
