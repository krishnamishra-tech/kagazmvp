    { "id": "annual_income",    "canonical": "annual_income",    "label_hi": "वार्षिक आय",      "required": true,  "validation": "^[0-9]{3,8}$", "user_must_confirm": true, "coordinates": [110, 480] },
    { "id": "mobile",           "canonical": "mobile",           "label_hi": "मोबाइल नंबर",     "required": true,  "coordinates": [320, 480] }
