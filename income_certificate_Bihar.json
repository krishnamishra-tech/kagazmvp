  "required_supporting_docs": [
    "Aadhaar card copy",
    "Residential proof",
    "Recent passport photo"
  ],
  "post_fill_instructions_hi": "फॉर्म भरने के बाद RTPS काउंटर या ऑनलाइन पोर्टल (serviceonline.bihar.gov.in) पर जमा करें। सामान्यतः 10-15 कार्यदिवसों में प्रमाण पत्र जारी होता है।"
}
